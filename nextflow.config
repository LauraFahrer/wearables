params {

    dataset = "${projectDir}/data/pupil_adhd_data/pupil_adhd_dataset.mat"
    dataset_id = 'pupil_adhd'
    metadata = "${projectDir}/data/metadata/pupil_adhd_metadata.json"

    class_column = 'Group'
    participant_column = 'Subject'    
    positive_label =
    negative_label =
    class_type = 'auto'
    correlation_threshold = 0.90
    pca_components = 3       

    dataset_config = "${projectDir}/data/datasets.yml"
    test_size = 0.2
    seed = 42

    // model tuning
    train_data = "${projectDir}/results/data_processing/splitted_data/train_data.tsv"
    target_column = 'class'
    sample_id_column = 'sample_id'
    group_column = ''              // e.g. participant id -> grouped CV, prevents leakage
    scaling = 'standard'           // standard | minmax | robust | none
    imputation = 'median'          // mean | median | most_frequent
    cv_folds = 5
    scoring = 'balanced_accuracy'
    




}

profiles {
    docker {
        docker.enabled = true
    }
    
    test {
        includeConfig 'test.config'
    }
}