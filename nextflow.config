params {
    dataset_config = "${projectDir}/data/datasets.yml"
    dataset = 'test'
    test_size = 0.2
    seed = 42
    dataset_file = "${projectDir}/data/Sleep_health_and_lifestyle_dataset.tsv"
    checksum_file = "${projectDir}/data/metadata/test_metadata.json"
    class_column = 'class'
    participant_column = 'participant_id'
    positive_label = 'positive'
    negative_label = 'negative'
    class_type = 'auto'
    correlation_threshold = 0.90
    pca_components = 3
}

profiles {
    docker {
        docker.enabled = true
    }
    
    test {
        includeConfig 'test.config'
    }
}