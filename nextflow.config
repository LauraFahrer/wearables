params {
    workflow = 'data_processing'
    dataset_config = "${projectDir}/data/datasets.yml"
    dataset = 'test'
    test_size = 0.2
    seed = 42
    dataset_file = "${projectDir}/data/test_dataset.tsv"
    checksum_file = "${projectDir}/data/metadata/test_metadata.json"
}

profiles {
    docker {
        docker.enabled = true
    }
    
    test {
        includeConfig 'test.config'
    }
}